{
  "expo": {
    "name": "Tipid",
    "slug": "Tipid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/tipid-logo.png",
    "scheme": "tipid",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "buildToolsVersion": "35.0.0",
      "adaptiveIcon": {
        "foregroundImage": "./assets/tipid-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kenshix.tipidapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/tipid-logo-w-title.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#transparent",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "11981916-3206-4c55-a29d-62a9204369f7"
      }
    }
  }
}
